# App role, with search_path=fbads. Supabase transaction pooler username: role.project-ref
DATABASE_URL=postgres://fbads_app.PROJECT_REF:PASSWORD@aws-0-REGION.pooler.supabase.com:6543/postgres
# Database administrator URL used only by npm run migrate; do not set on the hosted app.
MIGRATION_DATABASE_URL=
# Local test databases only. Production always verifies TLS.
DATABASE_SSL=
SUPABASE_PROJECT_ID=

# Bootstrap account username: admin. At least 16 characters in production.
ADMIN_PASSWORD=
# Optional separate accounts; overrides ADMIN_PASSWORD. Each password >=16 characters.
# {"alice":{"password":"...","role":"operator"},"bob":{"password":"...","role":"viewer"}}
ADMIN_USERS_JSON=

# Same random secret (>=32 characters) in app and engine. Never expose in browser/client variables.
ENGINE_TOKEN=
ENGINE_BASE_URL=http://localhost:3100

# Durable generated media: Supabase project URL, public bucket, engine-only service key.
STORAGE_URL=
STORAGE_BUCKET=
STORAGE_SERVICE_KEY=
